package-as: TOGBankClassic

curseforge-project-id: 1400244

enable-toc-creation: no
enable-nolib-creation: yes

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

required-dependencies:
  - versioncheck
  - ace3
  - libguildroster
  - acecommqueue
  - libitemdb
  - deltasync
  - libaceguiwidgets
  - libdbicon-1-0
  - libprofessiondb

ignore:
  - docs
  - tools
  - Tests
  - CLAUDE.md
  - CHANGELOG_ARCHIVE.md
  - wow-version-replication.ps1
  - "*.ps1"
  - "*.bat"
  - "*.code-workspace"
  - "Libs/*/README.md"
  - "Libs/*/README.textile"
  - "Textures/README.md"
  - "tmpclaude-*"
  - "*.bak"
  - "Thumbs.db"
