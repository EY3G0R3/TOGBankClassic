# .pkgmeta
package-as: TOGBankClassic

curseforge-project-id: 1400244

# Both flavour TOCs (TOGBankClassic.toc @ 11509, TOGBankClassic_BCC.toc @ 20506)
# are checked in and maintained by hand, so the packager must not generate them.
enable-toc-creation: no
enable-nolib-creation: yes

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Required dependencies for CurseForge auto-installation.
# NOTE: these are CurseForge SLUGS, which are not always the addon FOLDER name.
# The TOC's `## Dependencies:` line takes folder names instead — LibGuildRoster
# ships in a folder called `GuildRoster` but its slug is `libguildroster`
# (curseforge.com/wow/addons/libguildroster, project 1550433), so the two files
# spell it differently on purpose. Getting either wrong breaks silently: a bad
# slug skips auto-install, a bad folder name breaks load order.
required-dependencies:
  - versioncheck
  - ace3
  - libguildroster
  - acecommqueue
  - libitemdb
  - deltasync
  - libaceguiwidgets

# External dependencies (Ace3, VersionCheck) are handled via required-dependencies above

# Ignore syntax is unforgiving and fails SILENTLY -- a malformed entry matches
# nothing and the file ships anyway. Rules:
#   * Folders: bare name, NEVER a trailing slash. parse_ignore() trims "/*", not
#     "/", so "tools/" becomes "tools//*" and matches nothing. Use "tools".
#   * Globs: quoted, repo-relative, ONE star. match_pattern() uses shell `case`
#     globbing, which has no recursive "**". Unquoted "*.ps1" is a YAML alias
#     indicator and a parse error.
#   * Never list a dot-prefixed path. copy_directory_tree() prunes them all
#     unconditionally, so .git / .github / .vscode / .luarc.json entries are
#     no-ops that imply coverage they don't provide. wow-version-replication.ps1
#     mirrors that same prune in its own $AlwaysSkip rather than reading it here.
#   * NEVER put a trailing "# comment" on a list item. The parser strips one
#     leading and one trailing quote but not the comment, leaving an unbalanced
#     quote that breaks the eval in copy_directory_tree -- every file is copied
#     to an empty destination and the packager uploads a ~108-byte empty zip,
#     exit 0, CI green. Comments go on their own line.
ignore:
  - docs
  - tools
  - Tests
  - CLAUDE.md
  - CHANGELOG_ARCHIVE.md
  - wow-version-replication.ps1
  - "*.ps1"
  - "*.bat"
  - "*.code-workspace"
  - "Libs/*/README.md"
  - "Libs/*/README.textile"
  - "Textures/README.md"
  - "tmpclaude-*"
  - "*.bak"
  - "Thumbs.db"
